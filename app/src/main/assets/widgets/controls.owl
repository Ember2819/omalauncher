panel "controls" {
  // A control center for swiping down on home: the phone's switches, the volume, what's playing, the next alarm and
  // the notifications. Pick it in settings › gestures, or set gestures.swipe-down = "controls.owl" in style.toml.
  // Like the drawer it's yours to change: ask your agent to edit it.
  meta { description: "Swipe down for the phone's switches, volume, media, the next alarm and your notifications"; version: "1.0"; license: "MIT"; category: "system"; owl: 13 }
  asset gear = base64""
  source m = android.modes
  source v = android.volume
  source bat = android.battery
  source md = android.media
  source al = android.alarm
  // For the dot on the settings button while system updates wait, as the drawer shows it.
  source d = android.drawer
  source n = android.notifications
  source now = clock every 30s

  // The notification being answered, by key: its reply field shows under it.
  state replying = ""
  // The notification being swiped, by key, and how far; and the one let go of to dismiss, hidden until it's gone.
  state dragging = ""
  state dragX = 0
  state swiped = ""

  let wide = screenWidth ?? 400
  // The output's words, for one without a name of its own.
  let outputs = {speaker: "this phone", wired: "headphones", usb: "usb audio", hdmi: "hdmi", dock: "dock", bluetooth: "bluetooth"}
  let cols = wide >= 600 ? 6 : wide >= 440 ? 4 : 3
  // A switch, and what a tap does: torch and sound switch here; Android lets a launcher only read the others, so a
  // tap opens its own panel for them, settings(act).
  let toggles = [
      {name: "wifi", on: m.wifi == true, sub: (m.wifi ? "on" : "off"), act: "wifi"},
      {name: "bluetooth", on: m.bluetooth == true, sub: (m.bluetooth ? "on" : "off"), act: "bluetooth"},
      {name: "rotate", on: m.rotate == true, sub: m.rotate ? "auto" : "locked", act: "display"},
      {name: "airplane", on: m.airplane == true, sub: (m.airplane ? "on" : "off"), act: "airplane"},
      {name: "torch", on: m.torch == true, sub: m.torch == null ? "none" : (m.torch ? "on" : "off"), act: m.torch == null ? null : "torch"},
      {name: "location", on: m.location == true, sub: (m.location ? "on" : "off"), act: "location"},
      {name: "dark", on: m.dark == true, sub: (m.dark ? "on" : "off"), act: "dark"},
      {name: "dnd", on: m.dnd == true, sub: (m.dnd ? "on" : "off"), act: "dnd"},
      {name: "sound", on: !v.muted, sub: v.muted ? "muted" : "${v.level}%", act: "sound"},
      {name: "ringer", on: m.ringer == "normal", sub: m.ringer ?? "…", act: "volume"},
      {name: "saver", on: m.saver == true, sub: (m.saver ? "on" : "off"), act: "battery"},
      {name: "battery", on: bat.charging == true, sub: bat.charging ? "${bat.level}% ⚡" : "${bat.level}%", act: "battery"}
    ]
  let clearable = count(n.items ?? [], i => i.clearable)
  // The brightness as a bar of cells, as the volume reads at a glance; Android won't let a launcher set it.
  let cells = 16
  let lit = round((m.brightness ?? 0) / 100 * cells)

  component Bracket(label, act) {
    Text { text: "[ ${label} ]"; color: accent; padding: [0, 6]; onTap: { haptic(); launcher(act) } }
  }

  Column {
    fill: true
    gap: 12
    padding: 16
    scroll: true

    Row {
      fill: width
      align: center
      Text { text: "control"; fontSize: 28; color: accent; weight: 1 }
      // The drawer's settings button: settings › system updates lists what the dot counts.
      Box {
        size: 44
        radius: 22 * corners
        background: surface
        align: center
        onTap: launcher("settings")
        Image { src: gear; size: 22; tint: accent; label: "settings" }
        Box { visible: d.updates > 0; align: topEnd; size: 44; padding: 8; Box { size: 8; radius: 4; background: red } }
      }
    }

    Column {
      fill: width
      gap: 8
      padding: [14, 12]
      background: surface
      radius: 8 * corners
      Text { text: "toggles"; style: label }
      for row, r in chunk(toggles, cols) key r {
        Row {
          fill: width
          gap: 0
          for t in row {
            Row {
              weight: 1
              gap: 8
              align: top
              padding: [0, 4]
              onTap: {
                haptic()
                if t.act == "torch" {
                  torch("toggle")
                } else if t.act == "sound" {
                  volume("toggle")
                } else if t.act != null {
                  settings(t.act)
                }
              }
              Text { text: t.on ? "●" : "○"; color: t.on ? green : muted }
              Column {
                gap: 0
                weight: 1
                Text { text: t.name; color: t.on ? green : foreground; maxLines: 1 }
                Text { text: t.sub; style: small; color: muted; maxLines: 1 }
              }
            }
          }
          for s in range(0, cols - len(row)) { Spacer { weight: 1 } }
        }
      }
    }

    Column {
      fill: width
      gap: 8
      padding: [14, 12]
      background: surface
      radius: 8 * corners
      Text { text: "levels"; style: label }
      Row {
        fill: width
        align: center
        gap: 4
        onTap: settings("display")
        Text { text: "bright"; width: 72 }
        Text { spans: ["[", {text: pad("", lit, "█"), color: accent}, {text: pad("", cells - lit, "·"), color: muted}, "]"]; weight: 1; maxLines: 1 }
        Text { text: m.autoBrightness ? "☾ auto" : "☾ set"; color: orange; width: 56; align: end }
      }
      Row {
        fill: width
        align: center
        gap: 4
        Text { text: "volume"; width: 72 }
        Text { text: "["; color: accent }
        Slider { value: v.muted ? 0 : v.level; step: 100 / (v.steps ?? 15); live: true; color: accent; track: background; weight: 1; onChange: volume(value) }
        Text { text: "]"; color: accent }
        Text { text: v.muted ? "♪ off" : "♪ on"; color: orange; width: 56; align: end; onTap: volume("toggle") }
      }
      // Where the sound goes; a tap opens Android's output switcher, to move it to headphones or a speaker.
      Row {
        fill: width
        align: center
        gap: 4
        onTap: settings("output")
        Text { text: "output"; width: 72 }
        Text { text: v.output.name ?? outputs[v.output.type] ?? v.output.type; color: v.output.type == "speaker" ? foreground : green; weight: 1; maxLines: 1 }
        Text { text: "⇄ pick"; color: orange; width: 56; align: end }
      }
    }

    // Only while something plays or is paused in an app; without notification access there's nothing to show either.
    Column {
      visible: md.available == true && (md.title ?? "") != ""
      fill: width
      gap: 8
      padding: [14, 12]
      background: surface
      radius: 8 * corners
      Text { text: "media"; style: label }
      Row {
        fill: width
        align: center
        gap: 10
        Text { text: md.playing ? "❚❚" : "▶"; color: accent; width: 24; onTap: media("toggle") }
        Column {
          gap: 0
          weight: 1
          onTap: media("open")
          Text { text: md.title; maxLines: 1 }
          Text { text: md.artist ?? md.app ?? ""; style: small; color: muted; maxLines: 1 }
        }
        Text { text: "[ ⏮ ]"; color: accent; onTap: media("previous") }
        Text { text: "[ ⏭ ]"; color: accent; onTap: media("next") }
      }
    }

    Column {
      visible: al.set == true
      fill: width
      gap: 8
      padding: [14, 12]
      background: surface
      radius: 8 * corners
      Text { text: "next alarm"; style: label }
      Row {
        fill: width
        onTap: { if al.app != null { androidApp(al.app) } }
        Text { text: fmtTime(al.time, "EEE HH:mm"); weight: 1 }
        Text { text: "in " + fmtDuration(al.time - now); color: muted }
      }
    }

    Row {
      fill: width
      gap: 8
      Bracket { label: "style"; act: "style" }
      Bracket { label: "themes"; act: "themes" }
      Bracket { label: "agents"; act: "agents" }
      Bracket { label: "store"; act: "store" }
    }

    Spacer { height: 1; fill: width; background: border }

    Row {
      fill: width
      align: center
      Text { text: "notifications ${n.count ?? 0}"; fontSize: 22; color: accent; weight: 1 }
      Text { text: "[ clear ]"; color: clearable > 0 ? accent : muted; onTap: { if clearable > 0 { notification("clear") } } }
    }

    if !n.available {
      // Without access, notification(...) opens the setting that grants it.
      Text { text: "[ allow notification access ]"; color: accent; onTap: notification("open", "") }
    } else if n.count == 0 {
      Text { text: "all clear"; color: muted }
    }

    for item in n.items ?? [] key item.key {
      // Swiped sideways it follows the finger and fades; let go past a third of the screen, or flicked, it's dismissed.
      // Sideways only, so the panel still scrolls under a finger that lands on a notification.
      Column {
        fill: width
        gap: 8
        visible: item.key != swiped
        offset: [dragging == item.key ? dragX : 0, 0]
        opacity: dragging == item.key ? max(0.2, 1 - abs(dragX) / wide) : 1
        drag: horizontal
        onDrag: {
          if item.clearable {
            dragging = item.key
            dragX = dragX + dx
          }
        }
        onDragEnd: {
          if dragging == item.key && (abs(dragX) > wide / 3 || abs(vx) > 1000 && sign(vx) == sign(dragX)) {
            swiped = item.key
            notification("dismiss", item.key)
          }
          dragging = ""
          dragX = 0
        }
        Row {
          fill: width
          gap: 10
          align: top
          Text { text: lower(item.app); color: muted; width: 84; maxLines: 1; onTap: notification("open", item.key) }
          Text {
            spans: [{text: item.title, color: foreground}, item.text != "" ? "  " : "", {text: item.text, color: muted}]
            maxLines: 2
            weight: 1
            onTap: notification("open", item.key)
          }
          Text { text: fmtAgo(item.time, now); style: small; color: muted; width: 36; align: end }
        }
        // Its buttons, as the shade shows them: one that takes text opens a field for the answer.
        if len(item.actions) > 0 {
          Row {
            fill: width
            gap: 4
            padding: [94, 0, 0, 0]
            for a, i in item.actions {
              Text {
                text: "[ ${lower(a.title)} ]"
                style: small
                color: accent
                maxLines: 1
                onTap: {
                  if a.reply {
                    replying = replying == item.key ? "" : item.key
                  } else {
                    notification("action", item.key, i)
                  }
                }
              }
            }
          }
        }
        if replying == item.key {
          Input {
            fill: width
            padding: [94, 0, 0, 0]
            placeholder: "reply to ${item.title}"
            focus: true
            clear: true
            onSubmit: {
              notification("reply", item.key, value)
              replying = ""
            }
          }
        }
      }
    }

    Text { text: "~ ❯ swipe down on home · tap opens · swipe away dismisses"; style: small; color: muted }
  }
}
